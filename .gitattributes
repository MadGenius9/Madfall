# ---------------------------------------------------------------------------
# MadFall — line endings
# ---------------------------------------------------------------------------
*                       text=auto

*.cpp                   text diff=cpp
*.h                     text diff=cpp
*.inl                   text diff=cpp
*.cs                    text diff=csharp
*.py                    text diff=python
*.ini                   text
*.json                  text
*.md                    text
*.uproject              text
*.uplugin               text
*.ps1                   text eol=crlf
*.bat                   text eol=crlf
*.sh                    text eol=lf

# ---------------------------------------------------------------------------
# Git LFS — every binary UE asset type.
# Adding a type here AFTER files are committed does not retroactively move
# them into LFS; run `git lfs migrate import` if that happens.
# ---------------------------------------------------------------------------
*.uasset                filter=lfs diff=lfs merge=lfs -text
*.umap                  filter=lfs diff=lfs merge=lfs -text
*.upk                   filter=lfs diff=lfs merge=lfs -text
*.udk                   filter=lfs diff=lfs merge=lfs -text
*.pak                   filter=lfs diff=lfs merge=lfs -text
*.ucas                  filter=lfs diff=lfs merge=lfs -text
*.utoc                  filter=lfs diff=lfs merge=lfs -text
*.uexp                  filter=lfs diff=lfs merge=lfs -text
*.ubulk                 filter=lfs diff=lfs merge=lfs -text

